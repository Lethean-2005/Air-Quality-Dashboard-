# Base URL of the Laravel backend (no trailing slash, no /api suffix).
# Local dev: leave unset — src/services/api.js falls back to http://127.0.0.1:8001
# Production (Vercel): set this to your Render backend's URL, e.g.
#   VITE_API_BASE_URL=https://air-quality-backend.onrender.com
VITE_API_BASE_URL=
